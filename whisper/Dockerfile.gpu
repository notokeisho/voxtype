# GPU (CUDA) version of Whisper server
FROM nvidia/cuda:12.2.0-devel-ubuntu22.04 AS builder

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY whisper.cpp/ ./whisper.cpp/

WORKDIR /build/whisper.cpp

# Compile jobs. The CUDA build is memory hungry, so a small VM may need fewer
# than the available cores: docker compose build --build-arg BUILD_JOBS=2
ARG BUILD_JOBS=4

# libcuda.so.1 comes from the NVIDIA driver at runtime, injected by the
# container toolkit. The devel image only ships a link-time stub named
# libcuda.so, so the SONAME that libggml-cuda.so records cannot be resolved
# when the executable is linked. The symlink and -rpath-link below exist only
# in this build stage; neither ends up in the binary or the runtime image.
RUN ln -s libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1

# Build with CUDA support.
# Only whisper-server is shipped, so building the other examples and the tests
# costs time and can fail on targets this image never runs.
# CMAKE_CUDA_ARCHITECTURES=86 is the RTX 3060 (Ampere); the default list builds
# several extra architectures.
RUN cmake -B build \
    -DWHISPER_BUILD_SERVER=ON \
    -DWHISPER_BUILD_TESTS=OFF \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES=86 \
    -DCMAKE_EXE_LINKER_FLAGS="-Wl,-rpath-link,/usr/local/cuda/lib64/stubs" \
    && cmake --build build --config Release -j${BUILD_JOBS} --target whisper-server

FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/whisper.cpp/build/bin/whisper-server /app/
COPY --from=builder /build/whisper.cpp/build/src/libwhisper.so* /usr/local/lib/
COPY --from=builder /build/whisper.cpp/build/ggml/src/libggml*.so* /usr/local/lib/
# The CUDA backend is built in its own subdirectory, so the glob above misses
# it. libggml.so links against it, and the server exits at startup without it.
COPY --from=builder /build/whisper.cpp/build/ggml/src/ggml-cuda/libggml-cuda.so* /usr/local/lib/
COPY start.sh /app/

RUN ldconfig && chmod +x /app/start.sh /app/whisper-server

# Fail the build instead of shipping an image that cannot start.
# libcuda.so.1 is expected to be missing here: the NVIDIA container toolkit
# injects the driver at runtime, so only the other libraries must resolve.
RUN ! ldd /app/whisper-server | grep "not found" | grep -qv "libcuda.so.1"

EXPOSE 8080

CMD ["/app/start.sh"]
